@page
@model InvoiceApp.Pages.Invoices.EditModel
@{
}

<h2 class="text-center mb-3">@Model.PageTitle</h2>

@if (Model.Mode == "delete")
{
    <div class="alert alert-warning">
        <strong>Warning!</strong> Are you sure you want to delete this invoice?
    </div>
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Mode" />

    <div class="row g-2 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Invoice Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Invoice Number</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Number" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.Number" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Status</label>
                        <div class="col-sm-8">
                            @if (Model.IsReadOnly)
                            {
                                <input asp-for="InvoiceDto.Status" class="form-control" readonly />
                            }
                            else
                            {
                                <select asp-for="InvoiceDto.Status" class="form-select">
                                    <option value="Pending">Pending</option>
                                    <option value="Paid">Paid</option>
                                </select>
                                <span asp-validation-for="InvoiceDto.Status" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Issue Date</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.IssueDate" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.IssueDate" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Due Date</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.DueDate" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.DueDate" class="text-danger"></span>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Client Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Client Name</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.ClientName" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.ClientName" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Email</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Email" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.Email" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Phone</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Phone" class="form-control" readonly="@Model.IsReadOnly" />
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.Phone" class="text-danger"></span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Address</label>
                        <div class="col-sm-8">
                            <textarea asp-for="InvoiceDto.Address" class="form-control" readonly="@Model.IsReadOnly"></textarea>
                            @if (!Model.IsReadOnly)
                            {
                                <span asp-validation-for="InvoiceDto.Address" class="text-danger"></span>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"> : : Services Details </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-lg-6">
                    <label class="form-label">Service</label>
                    <input class="form-control" asp-for="InvoiceDto.Service" readonly="@Model.IsReadOnly" />
                    @if (!Model.IsReadOnly)
                    {
                        <span asp-validation-for="InvoiceDto.Service" class="text-danger"></span>
                    }
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Quantity</label>
                    <input class="form-control" asp-for="InvoiceDto.Quantity" id="quantityInput" oninput="updateTotalPrice()" readonly="@Model.IsReadOnly" />
                    @if (!Model.IsReadOnly)
                    {
                        <span asp-validation-for="InvoiceDto.Quantity" class="text-danger"></span>
                    }
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Unit Price</label>
                    <input class="form-control" asp-for="InvoiceDto.UnitPrice" id="unitPriceInput" oninput="updateTotalPrice()" readonly="@Model.IsReadOnly" />
                    @if (!Model.IsReadOnly)
                    {
                        <span asp-validation-for="InvoiceDto.UnitPrice" class="text-danger"></span>
                    }
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Total Price</label>
                    <input class="form-control" readonly id="totalPriceInput" />
                </div>
            </div>
        </div>
    </div>

    @if (Model.Mode == "delete")
    {
        <button type="submit" class="btn btn-danger me-2">Delete</button>
    }
    else if (Model.Mode == "edit")
    {
        <button type="submit" class="btn btn-primary me-2">Save</button>
    }

    <a class="btn btn-outline-primary" asp-page="/Invoices/Index">Cancel</a>
</form>

<script>
    function updateTotalPrice() {
        let quantity = parseFloat(document.getElementById("quantityInput").value) || 0;
        let unitPrice = parseFloat(document.getElementById("unitPriceInput").value) || 0;

        let totalPrice = quantity * unitPrice;
        document.getElementById("totalPriceInput").value = totalPrice;
    }

    updateTotalPrice();
</script>