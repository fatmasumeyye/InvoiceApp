@page
@model InvoiceApp.Pages.Invoices.EditModel
@{
}

<h2 class="text-center mb-3">Edit Invoice</h2>

<form method="post">
    <input type="hidden" asp-for="Invoice.Id" />

    <div class="row g-2 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Invoice Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Invoice Number</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.Number" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Status</label>
                        <div class="col-sm-8">
                            <select asp-for="Invoice.Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Paid">Paid</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Issue Date</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.IssueDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Due Date</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.DueDate" class="form-control" />
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Client Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Client Name</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.ClientName" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Email</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.Email" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Phone</label>
                        <div class="col-sm-8">
                            <input asp-for="Invoice.Phone" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Address</label>
                        <div class="col-sm-8">
                            <textarea asp-for="Invoice.Address" class="form-control"></textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"> : : Services Details </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-lg-6">
                    <label class="form-label">Service</label>
                    <input class="form-control" asp-for="Invoice.Service" />
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Quantity</label>
                    <input class="form-control" asp-for="Invoice.Quantity" id="quantityInput" oninput="updateTotalPrice()" />
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Unit Price</label>
                    <input class="form-control" asp-for="Invoice.UnitPrice" id="unitPriceInput" oninput="updateTotalPrice()" />
                </div>

                <div class="col-lg-2 col-sm-4">
                    <label class="form-label">Total Price</label>
                    <input class="form-control" id="totalPriceInput" readonly />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2">Save</button>
    <a class="btn btn-outline-primary" asp-page="/Invoices/Index" role="button">Cancel</a>
</form>

<script>
    function updateTotalPrice() {
        let quantity = parseFloat(document.getElementById("quantityInput").value) || 0;
        let unitPrice = parseFloat(document.getElementById("unitPriceInput").value) || 0;

        document.getElementById("totalPriceInput").value = quantity * unitPrice;
    }

    updateTotalPrice();
</script>