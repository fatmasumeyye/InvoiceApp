@page
@model InvoiceApp.Pages.Invoices.IndexModel
@{
}

<h2 class="text-center mb-3">List of Invoices</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-primary" asp-page="/Invoices/Create">New Invoice</a>

    <form method="get" class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">Records per page:</label>

        <select name="pageSize" class="form-select" style="width: 90px;" onchange="this.form.submit()">
            @foreach (var size in Model.PageSizeOptions)
            {
                if (Model.PageSize == size)
                {
                    <option value="@size" selected>@size</option>
                }
                else
                {
                    <option value="@size">@size</option>
                }
            }
        </select>

        <input type="hidden" name="pageIndex" value="1" />
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Invoice Number</th>
            <th>Status</th>
            <th>Client</th>
            <th>Total Price</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody class="table-group-divider">
        @foreach (var invoice in Model.invoiceList)
        {
            <tr>
                <td>@invoice.Id</td>
                <td>@invoice.Number</td>

                <td>
                    @if (invoice.Status == "Paid")
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else if (invoice.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@invoice.Status</span>
                    }
                </td>

                <td>@invoice.ClientName</td>
                <td>@(invoice.UnitPrice* invoice.Quantity) $</td>
                <td>@invoice.IssueDate</td>
                <td>@invoice.DueDate</td>

                <td style="white-space:nowrap">
                    <a class="btn btn-primary btn-sm" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="edit">Edit</a>
                    <a class="btn btn-info btn-sm" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="details">Details</a>
                    <a class="btn btn-danger btn-sm" asp-page="/Invoices/Edit" asp-route-id="@invoice.Id" asp-route-mode="delete">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center">
        @if (Model.PageIndex > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-page="/Invoices/Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.PageIndex)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-page="/Invoices/Index" asp-route-pageIndex="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }
        }

        @if (Model.PageIndex < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-page="/Invoices/Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
        }
    </ul>
</nav>