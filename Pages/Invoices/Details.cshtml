@page
@model InvoiceApp.Pages.Invoices.DetailsModel
@{
}

<h2 class="text-center mb-3">Invoice Details</h2>

<div class="row g-2 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"> : : Invoice Details </div>
            <div class="card-body">

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Invoice Number</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.Number" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Status</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.Status" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Issue Date</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.IssueDate" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Due Date</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.DueDate" readonly />
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"> : : Client Details </div>
            <div class="card-body">

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Client Name</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.ClientName" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Email</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.Email" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Phone</label>
                    <div class="col-sm-8">
                        <input class="form-control" value="@Model.Invoice.Phone" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Address</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" readonly>@Model.Invoice.Address</textarea>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"> : : Services Details </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-6">
                <label class="form-label">Service</label>
                <input class="form-control" value="@Model.Invoice.Service" readonly />
            </div>

            <div class="col-lg-2 col-sm-4">
                <label class="form-label">Quantity</label>
                <input class="form-control" value="@Model.Invoice.Quantity" readonly />
            </div>

            <div class="col-lg-2 col-sm-4">
                <label class="form-label">Unit Price</label>
                <input class="form-control" value="@Model.Invoice.UnitPrice" readonly />
            </div>

            <div class="col-lg-2 col-sm-4">
                <label class="form-label">Total Price</label>
                <input class="form-control" value="@(Model.Invoice.UnitPrice* Model.Invoice.Quantity)" readonly />
            </div>
        </div>
    </div>
</div>

<a class="btn btn-primary" asp-page="/Invoices/Edit" asp-route-id="@Model.Invoice.Id">Edit</a>
<a class="btn btn-outline-primary" asp-page="/Invoices/Index">Back</a>