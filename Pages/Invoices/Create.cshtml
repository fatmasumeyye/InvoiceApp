@page
@model InvoiceApp.Pages.Invoices.CreateModel
@{
}

<h2 class="text-center mb-3">New Invoice</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-2 mb-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Invoice Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Invoice Number</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Number" class="form-control" />
                            <span asp-validation-for="InvoiceDto.Number" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Status</label>
                        <div class="col-sm-8">
                            <select asp-for="InvoiceDto.Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Paid">Paid</option>
                            </select>
                            <span asp-validation-for="InvoiceDto.Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Issue Date</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.IssueDate" class="form-control" />
                            <span asp-validation-for="InvoiceDto.IssueDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Due Date</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.DueDate" class="form-control" />
                            <span asp-validation-for="InvoiceDto.DueDate" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"> : : Client Details </div>
                <div class="card-body">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Client Name</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.ClientName" class="form-control" />
                            <span asp-validation-for="InvoiceDto.ClientName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Email</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Email" class="form-control" />
                            <span asp-validation-for="InvoiceDto.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Phone</label>
                        <div class="col-sm-8">
                            <input asp-for="InvoiceDto.Phone" class="form-control" />
                            <span asp-validation-for="InvoiceDto.Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label"> Address</label>
                        <div class="col-sm-8">
                            <textarea asp-for="InvoiceDto.Address" class="form-control"></textarea>
                            <span asp-validation-for="InvoiceDto.Address" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span> : : Invoice Items </span>
            <button type="button" class="btn btn-success btn-sm" onclick="addItemRow()">+ Add Row</button>
        </div>

        <div class="card-body">
            <table class="table" id="itemsTable">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th style="width: 120px;">Quantity</th>
                        <th style="width: 160px;">Unit Price</th>
                        <th style="width: 160px;">Total</th>
                        <th style="width: 100px;">Action</th>
                    </tr>
                </thead>

                <tbody id="itemsBody">
                    @for (int i = 0; i < Model.InvoiceDto.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                <input class="form-control service-input" asp-for="InvoiceDto.Items[i].Service" />
                                <span asp-validation-for="InvoiceDto.Items[i].Service" class="text-danger"></span>
                            </td>
                            <td>
                                <input class="form-control quantity-input" asp-for="InvoiceDto.Items[i].Quantity" oninput="updateTotals()" />
                                <span asp-validation-for="InvoiceDto.Items[i].Quantity" class="text-danger"></span>
                            </td>
                            <td>
                                <input class="form-control unit-price-input" asp-for="InvoiceDto.Items[i].UnitPrice" oninput="updateTotals()" />
                                <span asp-validation-for="InvoiceDto.Items[i].UnitPrice" class="text-danger"></span>
                            </td>
                            <td>
                                <input class="form-control line-total-input" readonly />
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" onclick="removeItemRow(this)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end">
                <strong>Grand Total:</strong>
                <input class="form-control d-inline-block ms-2" style="width: 180px;" readonly id="grandTotalInput" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2"> Create </button>
    <a class="btn btn-outline-primary" asp-page="/Invoices/Index" role="button"> Cancel </a>
</form>

<script>
    function updateIndexes() {
        let rows = document.querySelectorAll("#itemsBody tr");

        rows.forEach((row, index) => {
            row.querySelector(".service-input").setAttribute("name", `InvoiceDto.Items[${index}].Service`);
            row.querySelector(".quantity-input").setAttribute("name", `InvoiceDto.Items[${index}].Quantity`);
            row.querySelector(".unit-price-input").setAttribute("name", `InvoiceDto.Items[${index}].UnitPrice`);
        });
    }

    function updateTotals() {
        let rows = document.querySelectorAll("#itemsBody tr");
        let grandTotal = 0;

        rows.forEach(row => {
            let quantity = parseFloat(row.querySelector(".quantity-input").value) || 0;
            let unitPrice = parseFloat(row.querySelector(".unit-price-input").value) || 0;
            let lineTotal = quantity * unitPrice;

            row.querySelector(".line-total-input").value = lineTotal;
            grandTotal += lineTotal;
        });

        document.getElementById("grandTotalInput").value = grandTotal;
    }

    function addItemRow() {
        let tbody = document.getElementById("itemsBody");

        let row = document.createElement("tr");

        row.innerHTML = `
            <td>
                <input class="form-control service-input" />
            </td>
            <td>
                <input class="form-control quantity-input" value="1" oninput="updateTotals()" />
            </td>
            <td>
                <input class="form-control unit-price-input" value="0" oninput="updateTotals()" />
            </td>
            <td>
                <input class="form-control line-total-input" readonly />
            </td>
            <td>
                <button type="button" class="btn btn-danger btn-sm" onclick="removeItemRow(this)">Remove</button>
            </td>
        `;

        tbody.appendChild(row);
        updateIndexes();
        updateTotals();
    }

    function removeItemRow(button) {
        let rows = document.querySelectorAll("#itemsBody tr");

        if (rows.length <= 1) {
            alert("At least one invoice item is required.");
            return;
        }

        button.closest("tr").remove();
        updateIndexes();
        updateTotals();
    }

    updateIndexes();
    updateTotals();
</script>